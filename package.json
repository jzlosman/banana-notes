{
  "name": "banana-notes",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first macOS floating Markdown notepad.",
  "license": "MIT",
  "author": "Jeremy Zaborowski",
  "repository": {
    "type": "git",
    "url": "https://github.com/jzlosman/banana-notes.git"
  },
  "bugs": { "url": "https://github.com/jzlosman/banana-notes/issues" },
  "homepage": "https://github.com/jzlosman/banana-notes#readme",
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:web && bash scripts/build-app.sh",
    "test": "tsx --test web/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "lowlight": "3.3.0",
    "lucide": "0.468.0",
    "marked": "17.0.6",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.25.12",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
