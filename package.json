{
  "name": "banana-notes",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first macOS floating Markdown notepad.",
  "license": "MIT",
  "author": "Jeremy Zaborowski",
  "repository": {
    "type": "git",
    "url": "https://github.com/jzlosman/banana-notes.git"
  },
  "bugs": {
    "url": "https://github.com/jzlosman/banana-notes/issues"
  },
  "homepage": "https://github.com/jzlosman/banana-notes#readme",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:web && bash scripts/build-app.sh",
    "test": "tsx --test web/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "site:build": "tailwindcss -i site/src/site.css -o site/site.css --minify && node scripts/build-site.mjs",
    "site:dev": "node scripts/build-site.mjs && tailwindcss -i site/src/site.css -o site/site.css --watch"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "lowlight": "3.3.0",
    "lucide": "1.60.0",
    "marked": "17.0.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/overpass-mono": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
